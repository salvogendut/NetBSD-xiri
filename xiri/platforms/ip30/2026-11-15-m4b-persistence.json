  "design": "xiri/platforms/ip30/DESIGN",
  "implementation": {
    "harness": "xiri/platforms/probe-m4b.py",
    "kernel": "reuses the committed M4a XIRI_IP30_M4A kernel",
    "root_disk": "one disposable copy of the 8 GiB CHD; both boots use the same disk path and overlay=true",
    "first_boot": "remounts / read-write, creates small, nonzero-pattern 64 KiB multi-page, renamed and truncated files under /m4b-persist, records SHA-256 and ls -lnai metadata, runs sync, and halts with shutdown -h now",
    "truncate": "the image has no /usr/bin/truncate; a five-byte dd rewrite exercises truncation",
    "second_boot": "reuses disk.chd and disk.chd.diff.chd, checks read-only root, runs fsck -fn /dev/sd0a, compares hashes and metadata, checks the rename source is absent, and halts cleanly",
    "baseline": "reruns the committed M4a probe with the untouched source CHD",
    "pattern": "pages.bin is generated by awk as nonzero bytes 33 + ((page * 97 + offset * 13) % 94), making each 4 KiB page distinct and allocated; host-side verify_pattern rejects zeroed, swapped and repeated pages",
    "integrity": "the second boot must find the same overlay hash, an unchanged copied base and unchanged original inputs; any mismatch is a probe-error with nonzero exit and retained result.json/serial logs"
  },
