  "implementation": {
    "config": "sys/arch/sgimips/conf/XIRI_IP30_M3B3",
    "option": "XIRI_IP30_M3B3; XIRI_IP30_M3B2 remains a polled-only rebuildable checkpoint",
    "bridge_route": {
      "pin": 4,
      "source": "IOC3 SuperIO",
      "destination_widget": 8,
      "destination_packet_address": "0x80",
      "heart_vector": 16,
      "int_dest_upper": "0x00080000",
      "int_dest_lower": "0x00000080",
      "int_host4": 16,
      "int_mode": "bit 4 set for falling-edge clear packet",
      "int_enable": "bit 4 enabled after the HEART handler is established",
      "api": "xbridge_intr_route(), xbridge_intr_enable(), xbridge_intr_status()"
    },
    "ioc3_receive": {
      "uart": "UART A at slot-2 window offset 0x20178 (physical 0x1f620178)",
      "ier": "0x01 receive-data enable",
      "ioc3_int_enable_set": "bit 6 SERIAL_A (0x40)",
      "handler": "drains LSR/RBR into a 256-byte ring and increments the interrupt count",
      "console_reader": "cn_getc pops the ring and drains the UART directly under splhigh when the ring is empty",
      "ownership": "handler and console reader share one ring; splhigh serialises their UART/ring access so bytes are not stolen"
    },
    "self_test": {
      "hook": "heart_set_post_test(), after the M2b clock and interrupt-delivery checks",
      "method": "temporary UART loopback and splvm masking",
      "checks": [
        "masked injection leaves handler count unchanged with Bridge pin 4 set",
        "splx delivers vector 16 and the handler drains the byte",
        "Bridge pin 4 and IOC3 SERIAL_A clear after drain",
        "cn_getc returns the handler-delivered byte from the ring",
        "a second injected byte is drained directly by cn_getc under splvm without a handler call",
        "no additional interrupts, ring overruns or Bridge errors after 10 ms"
      ]
    },
    "markers": [
      "XIRI_IP30_M3B3_ROUTE_OK pin=4 vector=16",
      "XIRI_IP30_M3B3_RX_OK masked=deferred delivered=1 drained=1 polled=1 storm=0",
      "XIRI_IP30_M3B3_SERIAL_OK ticks=11 bridge_errors=0 overruns=0"
    ],
