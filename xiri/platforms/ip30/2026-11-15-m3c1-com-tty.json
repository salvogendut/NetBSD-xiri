    "config": "sys/arch/sgimips/conf/XIRI_IP30_M3C1",
    "attachment": "com0 at mainbus0 addr 0x1f620178 through the sgimips ioc3_com attachment",
    "console": "comcnattach1 maps IOC3 UART A, derives the baud reference from the SuperIO predivider, and installs comcons as cn_tab for polled early output",
    "tty": "com_attach_subr creates the tty; COM_HW_CONSOLE makes com set cn_tab->cn_dev to makedev(com major, unit)",
    "observed_tty": {
      "major": 36,
      "unit": 0,
      "cn_dev": "0x2400",
      "cdevsw": "com_cdevsw",
      "uart": "ns16650, no ERS, 16-byte FIFO"
    },
    "ordering": "mainbus probes com0 before heart0 and xbridge0; interrupt routing is deferred to heart_set_post_test() after the M2b checks and xbridge attach",
    "routing": {
      "source": "IOC3 SuperIO",
      "bridge_pin": 4,
      "heart_vector": 16,
      "handler": "comintr at IPL_VM",
      "ioc3_enable": "SERIAL_A (1 << 6)",
      "bridge_enable": "pin 4 after the handler is established"
    },
